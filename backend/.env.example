# AI Provider (options: openai, google, mock)
AI_PROVIDER=mock

# OpenAI Configuration (required if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Google AI Configuration (required if AI_PROVIDER=google)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-1.5-flash

# Security — replace before running outside local development
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=sqlite:///./restaurant_agent.db

# Admin credentials (used for initial seed only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password
ADMIN_NAME=Restaurant Admin

# Include the exact deployed frontend origin when hosting the frontend elsewhere.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Application
DEBUG=false
ENVIRONMENT=development
