# AI Provider (options: openai, google, mock)
AI_PROVIDER=mock

# OpenAI Configuration (required if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Google AI Configuration (required if AI_PROVIDER=google)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-1.5-flash

# Security — CHANGE THIS IN PRODUCTION
SECRET_KEY=change-me-in-production-use-a-long-random-string-here
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=sqlite:///./restaurant_agent.db

# Admin credentials (used for initial seed only)
ADMIN_EMAIL=admin@restaurant.ai
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=Restaurant Admin

# Application
DEBUG=false
ENVIRONMENT=development
